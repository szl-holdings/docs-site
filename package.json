{
  "name": "szl-docs-site",
  "version": "2.0.0",
  "description": "SZL Holdings unified documentation site",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node fix-relative-paths.mjs && node scripts/verify-experience.mjs --dist && node scripts/verify-built-links.mjs",
    "docs:preview": "vitepress preview docs",
    "test:experience": "node scripts/verify-experience.mjs",
    "test:deployment": "node --test scripts/test-deployment-manifest.mjs scripts/test-protected-source.mjs",
    "deployment:write": "node scripts/write-deployment-manifest.mjs",
    "deployment:verify": "node scripts/verify-deployment-manifest.mjs"
  },
  "devDependencies": {
    "mermaid": "^11.16.1",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "katex": "^0.18.1"
  },
  "overrides": {
    "vite": "^6.4.2",
    "esbuild": "^0.25.0"
  }
}
